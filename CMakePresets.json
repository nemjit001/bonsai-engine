{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "gcc-x64",
      "inherits": "base",
      "architecture": {
        "strategy": "external",
        "value": "x64"
      },
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "Linux",
        "rhs": "${hostSystemName}"
      }
    },
    {
      "name": "clang-x64",
      "inherits": "base",
      "architecture": {
        "strategy": "external",
        "value": "x64"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "msvc-x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "strategy": "external",
        "value": "x64"
      },
      "environment": {
        "CC": "cl",
        "CXX": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "Windows",
        "rhs": "${hostSystemName}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-x64-debug",
      "configurePreset": "gcc-x64",
      "configuration": "Debug"
    },
    {
      "name": "gcc-x64-release",
      "inherits": "gcc-x64-debug",
      "configuration": "Release"
    },
    {
      "name": "clang-x64-debug",
      "configurePreset": "clang-x64",
      "configuration": "Debug"
    },
    {
      "name": "clang-x64-release",
      "inherits": "clang-x64-debug",
      "configuration": "Release"
    },
    {
      "name": "msvc-x64-debug",
      "configurePreset": "msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "msvc-x64-release",
      "inherits": "msvc-x64-debug",
      "configuration": "Release"
    }
  ]
}
